# 知心后端环境变量示例
# ─────────────────────────────
# 复制本文件为 .env 并填入你自己的密钥即可启动
# cp .env.example .env

# ── 主聊陪伴者模型（必填）──
# 推荐：Deepseek-V4-flash 系列，免费层够用，首字延迟低
# 注：可用任何 OpenAI 兼容端点，包括 OpenAI / 智谱 / 通义千问 / DeepSeek 官方
CHAT_FLASH_BASE_URL=https://api.deepseek.com/v1
CHAT_FLASH_API_KEY=<YOUR_API_KEY_HERE>
CHAT_FLASH_MODEL_NAME=deepseek-chat
CHAT_FLASH_TTFB_TIMEOUT=6

# ── 回退模型（主聊失败时使用，建议与主聊不同厂商）──
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=<YOUR_FALLBACK_API_KEY_HERE>
CHAT_MODEL_NAME=qwen-turbo

# ── 安全风控模型（必填）──
# 建议用更强档：DeepSeek-V3 / GPT-4o / Claude 3.5 等
SAFETY_BASE_URL=https://api.deepseek.com/v1
SAFETY_API_KEY=<YOUR_SAFETY_API_KEY_HERE>
SAFETY_MODEL_NAME=deepseek-reasoner

# ── 语音合成 ──
# edge-tts 免费、无需密钥，默认中文女声
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 其他可选音色：
#   zh-CN-YunxiNeural    (男声·阳光)
#   zh-CN-YunyangNeural  (男声·专业新闻)
#   zh-CN-XiaoyiNeural   (女声·温柔)
#   zh-CN-YunjianNeural  (男声·体育解说)
#   zh-CN-liaoning-XiaobeiNeural (女声·东北话)
#   zh-CN-shaanxi-XiaoniNeural   (女声·陕西话)

# ── ChromaDB 本地持久化路径 ──
# 默认 ./chroma_db，会自动创建。Docker 部署可改为 /data/chroma_db
CHROMA_PATH=./chroma_db

# ── 服务监听端口（可选，默认 8000）──
# PORT=8000